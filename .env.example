# Hortobots Reality Clash WebGame - Environment Variables
PORT=3333
NODE_ENV=production

# Supabase PostgreSQL Connection String (Cloud Database - IPv4 Pooler para Render & Local)
DATABASE_URL=postgresql://postgres.rxfdjwdfinhqdwllzmcc:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Google Gmail SMTP (Envio Real de E-mails de Verificação 2FA)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-aplicativo-google

# Google Identity Services (GSI - Login Oficial Google)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=sua-chave-secreta-google
